#!/bin/bash
# Runs once when each game server boots.

# 1. Install the web server and the EFS mount helper.
dnf install -y httpd amazon-efs-utils

# 2. Web page showing which server and AZ answered.
TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
AZ=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/availability-zone)
echo "<h1>Hostname: $(hostname)</h1><h2>Availability Zone: $AZ</h2>" > /var/www/html/index.html
systemctl enable --now httpd

# 3. Mount the shared EFS file system (TLS), and keep it mounted after reboot.
mkdir -p /mnt/efs
echo "${efs_id}:/ /mnt/efs efs _netdev,tls,nofail 0 0" >> /etc/fstab
for i in $(seq 1 40); do
  mount /mnt/efs && break
  sleep 15 # new mount targets can take several minutes to appear in DNS
done
